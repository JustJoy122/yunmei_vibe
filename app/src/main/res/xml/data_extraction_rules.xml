<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份与换机迁移规则（对应 Manifest 的 android:dataExtractionRules）。
  与 backup_rules.xml 保持一致：偏好与加密存储都不进云备份；
  换机直传同样排除加密存储（Keystore 密钥不随传输迁移，旧密文无法解密）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="settings.xml" />
        <exclude domain="sharedpref" path="yunmei_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="yunmei_secure.xml" />
    </device-transfer>
</data-extraction-rules>